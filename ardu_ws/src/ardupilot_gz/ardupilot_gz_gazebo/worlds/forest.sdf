<?xml version="1.0" ?>
<!--
  GENERATED by worldgen/generate_forest.py - edit the generator, not this
  file. 200 x 200 m forest edge (PS000183): forest + elephant corridor (N),
  camera towers T1-T3, crop fields, village (S); forest station at the origin.
  Same frame, lights, sky and GPS origin as disaster.sdf.
-->
<sdf version="1.9">
  <world name="forest">
    <physics name="1ms" type="ignore">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics">
    </plugin>
    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands">
    </plugin>
    <plugin filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster">
    </plugin>
    <plugin filename="gz-sim-air-pressure-system"
      name="gz::sim::systems::AirPressure">
    </plugin>
    <plugin filename="gz-sim-air-speed-system"
      name="gz::sim::systems::AirSpeed">
    </plugin>
    <plugin filename="gz-sim-altimeter-system"
      name="gz::sim::systems::Altimeter">
    </plugin>
    <plugin filename="gz-sim-imu-system"
      name="gz::sim::systems::Imu">
    </plugin>
    <plugin filename="gz-sim-magnetometer-system"
      name="gz::sim::systems::Magnetometer">
    </plugin>
    <plugin filename="gz-sim-navsat-system"
      name="gz::sim::systems::NavSat">
    </plugin>
    <plugin filename="gz-sim-particle-emitter-system"
      name="gz::sim::systems::ParticleEmitter">
    </plugin>

    <!-- Lighting identical to runway.sdf (see the notes there): low
         ambient + shadowless "fill" + "sun", so the command center's
         day/night switch applies the same values. Hazy grey-brown sky
         for the dust in the air. -->
    <scene>
      <ambient>0.15 0.15 0.15</ambient>
      <background>0.62 0.58 0.52</background>
    </scene>

    <light type="directional" name="fill">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.4 0.4 0.4 1</diffuse>
      <specular>0 0 0 1</specular>
      <direction>0 0 -1</direction>
    </light>

    <!-- Background temperature for the thermal camera (15 C). Objects
         with no thermal plugin render at this temperature, varied by how
         bright their texture is; Gazebo scales that spread with
         temperature_gradient. At the real-atmosphere -0.0065 K/m, white
         stones in the rubble read up to 347 K (hotter than a person) and
         dark ones hit the camera's 250 K floor, so the thermal model saw
         "people" all over the debris. -0.0003 gives a realistic
         ~285-289 K spread. -->
    <atmosphere type="adiabatic">
      <temperature>288</temperature>
      <temperature_gradient>-0.0003</temperature_gradient>
    </atmosphere>

    <!-- Must match SUN_DIRECTION_ENU in mavlink_bridge.py. -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.7 0.7 0.7 1</diffuse>
      <specular>0.8 0.8 0.8 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Sky: two emissive domes instead of <sky>, which can't change while
         the sim runs. The command center's night mode moves sky_day out of
         sight and sky_night to the origin (and back for day); the poses here
         and in server.py's NIGHT_POSES must match. -->
    <include>
      <name>sky_day</name>
      <uri>model://sky_dome</uri>
      <pose>0 0 0 0 0 0</pose>
    </include>
    <include>
      <name>sky_night</name>
      <uri>model://sky_dome_night</uri>
      <pose>0 0 -100000 0 0 0</pose>
    </include>

    <spherical_coordinates>
      <latitude_deg>-35.3632621</latitude_deg>
      <longitude_deg>149.1652374</longitude_deg>
      <elevation>10.0</elevation>
      <heading_deg>0</heading_deg>
      <surface_model>EARTH_WGS84</surface_model>
    </spherical_coordinates>

    
    <include><uri>model://forest_scenery</uri></include>

    <!-- Village houses and the forest station office (Fuel, render-checked in Harmonic) -->
    <include><name>indian_house_0</name><uri>https://fuel.gazebosim.org/1.0/hisuki/models/Indian House</uri><pose>-40.00 -80.00 0 0 0 0.30</pose><static>true</static></include>
    <include><name>indian_house_1</name><uri>https://fuel.gazebosim.org/1.0/hisuki/models/Indian House</uri><pose>10.00 -84.00 0 0 0 -0.20</pose><static>true</static></include>
    <include><name>indian_house_2</name><uri>https://fuel.gazebosim.org/1.0/hisuki/models/Indian House</uri><pose>-62.00 -88.00 0 0 0 1.20</pose><static>true</static></include>
    <include><name>forest_office</name><uri>https://fuel.gazebosim.org/1.0/hisuki/models/House</uri><pose>13.00 -6.00 0 0 0 3.14</pose><static>true</static></include>
    <include><name>forest_jeep</name><uri>model://pickup</uri><pose>-8 -9 0 0 0 1.57</pose><static>true</static></include>

    <!-- Camera towers (Sentinel) -->
    <!-- Camera tower T1: East edge (grazing land). Aimed at (55.0, 30.0). -->
    <model name="tower_t1"><static>true</static><pose>55.0 4.0 0 0 0 1.5708</pose>
      <link name="mast">
        <visual name="pole"><pose>0 0 3.0 0 0 0</pose><geometry><cylinder><radius>0.12</radius><length>6.0</length></cylinder></geometry><material><ambient>0.45 0.45 0.45 1</ambient><diffuse>0.55 0.55 0.55 1</diffuse></material></visual>
        <visual name="base"><pose>0 0 0.2 0 0 0</pose><geometry><box><size>0.9 0.9 0.4</size></box></geometry><material><ambient>0.45 0.45 0.45 1</ambient><diffuse>0.55 0.55 0.55 1</diffuse></material></visual>
        <visual name="solar"><pose>-0.3 0 4.8 0 -0.5 0</pose><geometry><box><size>0.9 1.4 0.05</size></box></geometry>
          <material><ambient>0.05 0.08 0.2 1</ambient><diffuse>0.08 0.12 0.3 1</diffuse><specular>0.6 0.6 0.6 1</specular></material></visual>
        <visual name="cabinet"><pose>0.18 0 1.4 0 0 0</pose><geometry><box><size>0.25 0.4 0.5</size></box></geometry><material><ambient>0.45 0.45 0.45 1</ambient><diffuse>0.55 0.55 0.55 1</diffuse></material></visual>
      </link>
      <link name="head"><pose>0 0 6.15 0 0.2268 0</pose>
        <visual name="housing"><pose>0.1 0.09 0 0 0 0</pose><geometry><box><size>0.35 0.12 0.12</size></box></geometry>
          <material><ambient>0.85 0.85 0.85 1</ambient><diffuse>0.9 0.9 0.9 1</diffuse></material></visual>
        <visual name="housing_ir"><pose>0.1 -0.09 0 0 0 0</pose><geometry><box><size>0.3 0.12 0.12</size></box></geometry>
          <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material></visual>
        <sensor name="rgb" type="camera">
          <pose>0.25 0 0 0 0 0</pose>
          <topic>/tower/t1/image</topic>
          <camera><horizontal_fov>1.2</horizontal_fov>
            <image><width>1280</width><height>720</height></image>
            <clip><near>0.3</near><far>400</far></clip></camera>
          <always_on>1</always_on><update_rate>10</update_rate>
        </sensor>
        <sensor name="thermal" type="thermal">
          <pose>0.25 0 0 0 0 0</pose>
          <topic>/tower/t1/thermal</topic>
          <camera><horizontal_fov>1.2</horizontal_fov>
            <image><width>640</width><height>480</height><format>L16</format></image>
            <clip><near>0.3</near><far>400</far></clip></camera>
          <always_on>1</always_on><update_rate>10</update_rate>
          <plugin filename="gz-sim-thermal-sensor-system" name="gz::sim::systems::ThermalSensor">
            <min_temp>250</min_temp><max_temp>350</max_temp><resolution>0.01</resolution></plugin>
        </sensor>
      </link>
    </model>

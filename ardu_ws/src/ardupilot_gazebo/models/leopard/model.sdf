<?xml version="1.0"?>
<!-- leopard: 0.7 m tall, body along +X, feet at z=0. Visual only: no
     collision, like the other animals, so moving it costs no physics.
     The GLB is Y-up; Gazebo loads it as-is, hence the +90 deg roll. -->
<sdf version="1.9">
  <model name="leopard">
    <static>true</static>
    <link name="body">
      <visual name="visual">
        <pose>0.0842 0.0126 0.0055 1.5708 0 1.5708</pose>
        <geometry><mesh><uri>model://leopard/meshes/model.glb</uri><scale>6.321929 6.321929 6.321929</scale></mesh></geometry>
        <!-- Skin temperature for the thermal cameras (ground is ~288 K). -->
        <plugin filename="gz-sim-thermal-system" name="gz::sim::systems::Thermal"><temperature>305</temperature></plugin>
      </visual>
    </link>
  </model>
</sdf>

<?xml version="1.0"?>
<!-- cow_holstein: 1.4 m tall, body along +X, feet at z=0. Visual only: no
     collision, like the region scenery, so moving it costs no physics.
     The GLB is Y-up; Gazebo loads it as-is, hence the +90 deg roll. -->
<sdf version="1.9">
  <model name="cow_holstein">
    <static>true</static>
    <link name="body">
      <visual name="visual">
        <pose>1.8016 2.1427 -0.0000 1.5708 0 3.1416</pose>
        <geometry><mesh><uri>model://cow_holstein/meshes/model.glb</uri><scale>0.053087 0.053087 0.053087</scale></mesh></geometry>
        <!-- Skin temperature for the thermal cameras (ground is ~288 K). -->
        <plugin filename="gz-sim-thermal-system" name="gz::sim::systems::Thermal"><temperature>304</temperature></plugin>
      </visual>
    </link>
  </model>
</sdf>
